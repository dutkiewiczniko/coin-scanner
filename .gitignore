__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
build/
dist/
.pytest_cache/

# Data and model artefacts — tracked outside git.
# Photos are matched by extension rather than by folder, so a new batch
# directory is covered without having to remember to add it. Git stores JPEGs
# whole with no delta compression, so each one would be carried forever.
data/**/*.jpg
data/**/*.jpeg
data/**/*.png
data/**/*.heic
data/**/*.dng
data/raw/
data/crops/
data/crops_new/
data/dataset/
data/out/
models/*.pt
models/*.pth
*.sqlite
*.sqlite3

# API credentials. The eBay Cert ID and the Numista key live here rather than in
# config/default.yaml, which is committed.
.env

# Cached Numista API responses. Kept out of git deliberately: the terms of use
# forbid redistributing a substantial part of their database, and a committed
# cache is exactly that.
data/cache/
