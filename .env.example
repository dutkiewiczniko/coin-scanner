# Copy to .env and fill in. .env is gitignored; this template is not.
#
# eBay: developer.ebay.com -> Your Account -> Application Keys (Production).
# EBAY_CLIENT_ID is eBay's "App ID", EBAY_CLIENT_SECRET is its "Cert ID".
# The Dev ID is not needed -- it belongs to the legacy Trading/Finding APIs.
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=

# Numista: free key from https://en.numista.com/api/
NUMISTA_API_KEY=
ANTHROPIC_API_KEY=
